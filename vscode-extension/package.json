{
  "name": "helix-mcp-client",
  "displayName": "Helix AI Assistant",
  "description": "AI-powered code assistant with multi-agent system, Git operations, and web research using NVIDIA NIMs",
  "version": "1.0.0",
  "publisher": "helix-dev",
  "author": "Helix Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whynotshrutz/Helix"
  },
  "bugs": {
    "url": "https://github.com/whynotshrutz/Helix/issues"
  },
  "homepage": "https://github.com/whynotshrutz/Helix#readme",
  "keywords": [
    "ai",
    "code-assistant",
    "nvidia",
    "git",
    "multi-agent",
    "code-generation",
    "copilot"
  ],
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0"
  },
  "contributes": {
    "configuration": {
      "title": "Helix AI",
      "properties": {
        "helix.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8001",
          "description": "Helix backend server URL. Set this to your production server URL when deployed."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "helix-chat",
          "title": "Helix AI",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "helix-chat": [
        {
          "type": "webview",
          "id": "helixChatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "helixMcp.openChat",
        "title": "Open Helix Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "helixMcp.clearChat",
        "title": "Clear Chat History"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "helixMcp.clearChat",
          "when": "view == helixChatView",
          "group": "navigation"
        }
      ]
    }
  }
}
